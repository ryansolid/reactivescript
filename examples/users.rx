// An async data table: a page of users is a question on `page`; editing a name is
// an optimistic guess confirmed by the save; the table keeps its last page while
// the next loads (declared lag), and the header shows the lag.
import pure { fetchUsers, saveUser } from "./api"
import pure { len } from "./prelude"

type User = { id: number; name: string; email: string }

source page: number := 1
source query: string := ""
source users: User[] = await fetchUsers(page, query) -> []    // ST-5: a source with a standing question; R-7: an empty first paint
source editing: number | null = null                          // a question whose truth is `null`: a guess over it ends the edit now (AC-3)
source saveError: string := ""

total = len(users)
status = pending? users ? "loading…" : `${total} users`

action rename(id: number, name: string) {
  guess users := us => us.map(u => u.id === id ? { ...u, name } : u)   // AC-3: shown now, verdict-inert
  guess editing := null                                                 // the editor closes now; the plain write below lands at the commit
  editing := null
  saveError := ""
  try {
    let saved = await saveUser(id, name)                                     // AC-1: the change stays open
    users := us => us.map(u => u.id === id ? saved : u)                      // the truth: equal confirms silently
  } catch (e) {
    saveError := `could not save ${name}: ${e.message}`                      // R-f-6; the guess reverts at the body's end
  }
}
action nextPage() { page := page + 1 }
action search(q: string) { query := q; page := 1 }

component Row(props: { user: User }) {
  isEditing = editing === props.user.id
  <tr>
    <td>{props.user.id}</td>
    <td>
      {if isEditing {
        <input value={props.user.name} onChange={e => { rename(props.user.id, e.target.value) }} />
      } else {
        <span onClick={() => { editing := props.user.id }}>{props.user.name}</span>
      }}
    </td>
    <td>{props.user.email}</td>
  </tr>
}

export default component App() {
  errored fallback(e) { <p class="error">Could not load users: {e.message}</p> } {   // R-f-5: the fetches can fail; one boundary at the root discharges them
    <section>
      <header>
        <input placeholder="search" onInput={e => { search(e.target.value) }} />
        <span class={pending? users ? "dim" : ""}>{status}</span>{saveError}
      </header>
      {loading on(query) fallback { <p>Searching…</p> } {
        <table><tbody>{for u in users { <Row user={u} /> }}</tbody></table>   // SV-7d: a <tr> from another template goes in a <tbody>
      }}
      <button onClick={() => { nextPage() }} disabled={pending? users}>Next page ({latest page})</button>
    </section>
  }
}
