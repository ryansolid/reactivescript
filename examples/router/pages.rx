// The pages the router renders: plain .rx components, named in the route table (MO-11f).
import { useParams, useNavigate } from "./router.js"
import { fetchPerson, NotFound } from "./people.js"

export component Layout(props) {
  <nav><a href="/">Home</a> <a href="/people/1">Ann</a> <a href="/people/2">Bo</a> <a href="/people/9">Nobody</a></nav>   // the router handles a link's click
  <main>{props.children}</main>
}

export component Home() {
  navigate = useNavigate()
  action meetBo() { navigate("/people/2") }
  <h1>People</h1>
  <button onClick={meetBo}>Meet Bo</button>
}

export component Person() {
  params = useParams()                      // MO-11d: the router's store; params.id follows the URL
  person = await fetchPerson(params.id)     // MO-11e: a route's data, asked again when the param changes
  errored fallback(e: NotFound) { <p class="missing">{e.message}</p> } {
    loading fallback { <p>loading…</p> } {
      <h1>{person.name}</h1>
      <p>{person.role}, #{params.id}</p>
    }
  }
}
