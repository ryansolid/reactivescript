// theme.rx — the two contexts the settings page renders under.
// This module owns no state: it only declares what the contexts are (RG-7a).

export type Theme = "light" | "dark"
export type Density = "comfortable" | "compact"

// The theme being edited, and the one write its owner allows (O-4): a picker
// anywhere beneath the provider can change it without knowing who owns it.
export context theme: { current: Theme; pick: (t: Theme) => void }

// Layout density. Only some subtrees provide it; everywhere else it is the
// default (RG-7b).
export context density: Density = "comfortable"
