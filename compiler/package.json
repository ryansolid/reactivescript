{
  "name": "@reactivescript/compiler",
  "description": "ReactiveScript's compiler, in process through Node-API, and its front end for @solidjs/vite-plugin",
  "version": "0.3.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidjs/reactivescript.git",
    "directory": "compiler"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./vite": {
      "types": "./vite.d.mts",
      "default": "./vite.mjs"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "vite.mjs",
    "vite.d.mts",
    "guide/",
    "README.md"
  ],
  "scripts": {
    "build": "napi build --platform --release --strip --features node --manifest-path ./Cargo.toml -- --lib",
    "build:debug": "napi build --platform --features node --manifest-path ./Cargo.toml -- --lib",
    "artifacts": "napi artifacts",
    "create-npm-dirs": "napi create-npm-dirs",
    "version": "napi version && node scripts/sync-optional-deps.mjs",
    "prepack": "node scripts/guide.mjs",
    "test": "node test/node.mjs"
  },
  "napi": {
    "binaryName": "compiler",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "wasm32-wasip1-threads"
    ],
    "wasm": {
      "browser": {
        "fs": false,
        "asyncInit": false,
        "buffer": false,
        "errorEvent": true
      }
    }
  },
  "peerDependencies": {
    "@solidjs/vite-plugin": "*"
  },
  "peerDependenciesMeta": {
    "@solidjs/vite-plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@napi-rs/cli": "^3.10.6",
    "@napi-rs/wasm-runtime": "^1.1.6",
    "emnapi": "^1.11.3"
  }
}
