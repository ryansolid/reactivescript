// The issues page: the filtered list, the selected issue's detail, and the writes on it (assign, rename, close).

import pure { fetchIssues, fetchIssue } from "./api"
import { assign, renameIssue, closeIssue } from "./api"
import { Comments } from "./comments.rx"
import { Labels } from "./labels.rx"
import { Related } from "./related.rx"

export error NotFound(id: number) => `issue #${id} not found`

fn found(it, id: number) => it == null ? throw NotFound(id) : it

// the open list as shown (closes in flight already out of it) is the tab's count: it is read where the list is read,
// under the list's boundary, so it holds and reveals with the rows; other lists, loads and failures leave it as it was
component OpenCount(props: { n: number; onCount: (n: number) => void }) {
  effect (props.n) {
    props.onCount($0)
  }
}

export component IssuesPage(props: { onOpenCount: (n: number) => void; onOpenHelp: (query: string, id: number) => void }) {
  source user: string := "guest"
  source filter: string := "open"
  source selected: number | null := null
  source issues key id = await fetchIssues(filter)
  source detail = selected == null ? null : found(await fetchIssue(selected), selected)
  source titleInput: string := ""
  source assignError: string = ""
  source renameError: string = ""
  source closeError: string = ""


  action assignTo(id: number, who: string) {
    optimistic assignError := ""
    try {
      let i = issues.findIndex(t => t.id == id)
      optimistic issues[i].assignee := who
      await assign(id, who)
      refresh issues
    } catch (e) {
      assignError := e.message
    }
  }

  action renameTo(id: number, title: string) {
    optimistic renameError := ""
    try {
      let i = issues.findIndex(t => t.id == id)
      if (i >= 0) {
        optimistic issues[i].title := title
      }
      if (detail != null && detail.id == id) {
        optimistic detail.title := title
      }
      await renameIssue(id, title)
      refresh issues
      refresh detail
    } catch (e) {
      renameError := e.message
    }
  }

  action closeOne(id: number) {
    optimistic closeError := ""
    try {
      optimistic issues := issues.filter(t => t.id != id)
      await closeIssue(id)
      refresh issues
    } catch (e) {
      closeError := e.message
    }
  }

  <main>
    <div>
      <label>
        user{" "}
        <input data-testid="user" value={user} onInput={e => { user := e.target.value }} />
      </label>
    </div>
    <div>
      <button data-testid="filter-open" onClick={() => { filter := "open" }}>open</button>
      <button data-testid="filter-closed" onClick={() => { filter := "closed" }}>closed</button>
    </div>
    <div data-testid="list">
      {loading on(filter) fallback { <p>loading {latest filter} issues</p> } {
        {errored fallback(e) { <p>list error: {e.message}</p> } {
          {if filter == "open" {
            <OpenCount n={issues.length} onCount={n => { props.onOpenCount(n) }} />
          }}
          <ul>
            {for it in issues {
              <li data-testid="issue" onClick={() => {
                selected := it.id
                titleInput := ""
                onFlush(() => {
                  assignError := ""
                  renameError := ""
                  closeError := ""
                })
              }}>#{it.id} {it.title} ({it.assignee ?? "unassigned"})</li>
            }}
          </ul>
        }}
      }}
    </div>
    <div data-testid="detail">
      {if selected != null {
        {loading on(selected) fallback { <p>loading #{latest selected}</p> } {
          {errored fallback(e) { <p>detail error: {e.message}</p> } {
            <h2>#{detail.id} {detail.title}</h2>
            <p>{detail.body}</p>
            <Related title={detail.title} onOpen={(q, id) => { props.onOpenHelp(q, id) }} />
          }}
          <button data-testid="retry" onClick={() => { refresh detail }}>retry</button>
        }}
        <button data-testid="assign" onClick={() => { assignTo(selected, user) }}>assign to {user}</button>
        {if assignError != "" {
          <p data-testid="assign-error">{assignError}</p>
        }}
        <input data-testid="title-input" value={titleInput} onInput={e => { titleInput := e.target.value }} />
        <button data-testid="rename" onClick={() => { if (titleInput != "") { renameTo(selected, titleInput) } }}>rename</button>
        {if renameError != "" {
          <p>rename error: {renameError}</p>
        }}
        <button data-testid="close" onClick={() => { closeOne(selected) }}>close</button>
        {if closeError != "" {
          <p>close error: {closeError}</p>
        }}
        <Labels id={selected} />
        <Comments id={selected} user={user} />
      } else {
        <p>select an issue</p>
      }}
    </div>
  </main>
}
