import pure { fetchIssues, fetchIssue, fetchComments } from "./api"
import { assign, addComment } from "./api"
import pure { indexOf } from "./prelude"

export error NotFound(id: number) => `issue #${id} not found`

fn found(it, id: number) => it == null ? throw NotFound(id) : it

export default component App() {
  source user: string := "guest"
  source filter: string := "open"
  source selected: number | null := null
  source issues key id = await fetchIssues(filter)
  source assignError: string := ""
  source postError: string := ""
  source commentInput: string := ""
  source comments = selected == null ? [] : await fetchComments(selected)

  action postComment(id: number, author: string, text: string) {
    onFlush(() => { postError := "" })
    try {
      guess comments := [...comments, { author: author, text: `${text} (sending…)` }]
      await addComment(id, author, text)
      refresh comments
    } catch (e) {
      postError := e.message
    }
  }


  action assignTo(id: number, who: string) {
    onFlush(() => { assignError := "" })
    try {
      let i = indexOf(issues, t => t.id == id)
      guess issues[i].assignee := who
      await assign(id, who)
      refresh issues
    } catch (e) {
      assignError := e.message
    }
  }

  <main>
    <div>
      <label>
        user{" "}
        <input data-testid="user" value={user} onInput={e => { user := e.target.value }} />
      </label>
    </div>
    <div>
      <button data-testid="filter-open" onClick={() => { filter := "open" }}>open</button>
      <button data-testid="filter-closed" onClick={() => { filter := "closed" }}>closed</button>
    </div>
    <div data-testid="list">
      {loading on(filter) fallback { <p>loading {latest filter} issues</p> } {
        {errored fallback(e) { <p>list error: {e.message}</p> } {
          <ul>
            {for it in issues {
              <li data-testid="issue" onClick={() => {
                selected := it.id
                onFlush(() => {
                  assignError := ""
                  postError := ""
                })
              }}>#{it.id} {it.title} ({it.assignee ?? "unassigned"})</li>
            }}
          </ul>
        }}
      }}
    </div>
    <div data-testid="detail">
      {if selected != null {
        detail = found(await fetchIssue(selected), selected)
        {loading on(selected) fallback { <p>loading #{latest selected}</p> } {
          {errored fallback(e) { <p>detail error: {e.message}</p> } {
            <h2>#{detail.id} {detail.title}</h2>
            <p>{detail.body}</p>
          }}
          <button data-testid="retry" onClick={() => { refresh detail }}>retry</button>
        }}
        <button data-testid="assign" onClick={() => { assignTo(selected, user) }}>assign to {user}</button>
        {if assignError != "" {
          <p data-testid="assign-error">{assignError}</p>
        }}
        <div data-testid="comments">
          {loading on(selected) fallback { <p>loading comments</p> } {
            {errored fallback(e) { <p>comments error: {e.message}</p> } {
              <ul>
                {for c in comments {
                  <li data-testid="comment">{c.author}: {c.text}</li>
                }}
              </ul>
            }}
          }}
        </div>
        <input data-testid="comment-input" value={commentInput} onInput={e => { commentInput := e.target.value }} />
        <button data-testid="post" onClick={() => {
          if (commentInput != "") {
            let text = commentInput
            onFlush(() => { commentInput := "" })
            postComment(selected, user, text)
          }
        }}>post</button>
        {if postError != "" {
          <p>post error: {postError}</p>
        }}
      } else {
        <p>select an issue</p>
      }}
    </div>
  </main>
}
