// ui.rx — presentational components. Knows the contexts, not the settings module.

import { theme, density } from "./theme.rx"

// A titled section. Reads `density`, which is provided only under the form;
// in the loading and error screens it is the default.
export component Panel(props: { title: string; children: View }) {
  <section class={use density}>
    <h2>{props.title} [{use density}]</h2>{" "}
    {props.children}
  </section>
}

// Changes the theme through the function the context provides (O-4): it does
// not know, or import, who owns the theme.
export component ThemePicker(props: {}) {
  current = (use theme).current
  <div>
    <span>Theme: {current}</span>{" "}
    <button data-testid="theme-light" onClick={() => { (use theme).pick("light") }}>light</button>{" "}
    <button data-testid="theme-dark" onClick={() => { (use theme).pick("dark") }}>dark</button>
  </div>
}

// The appearance controls: the picker, whatever extra controls the caller
// passes, and a preview of both contexts.
export component Appearance(props: { children: View }) {
  <div class={(use theme).current}>
    <ThemePicker />{" "}
    {props.children}{" "}
    <p data-testid="preview">Preview: {(use theme).current} / {use density}</p>
  </div>
}
