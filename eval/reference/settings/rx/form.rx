// form.rx — the edit form. Owns the draft; hands it to `save` from settings.rx.

import { save, validate, NameRequired, NameTooLong, Settings } from "./settings.rx"
import { theme, density, Theme, Density } from "./theme.rx"
import { Panel, Appearance } from "./ui.rx"

// Mounted once the settings have loaded; the draft is seeded from them once
// (E-4) and then belongs to the form: a save that fails does not throw the
// user's edits away.
export component SettingsForm(props: { initial: Settings }) {
  source draftName: string := peek(props.initial.name)
  source draftTheme: Theme := peek(props.initial.theme)
  source draftDensity: Density := peek(props.initial.density)

  draft: Settings = { name: draftName, theme: draftTheme, density: draftDensity }
  valid = validate(draft)
  // The failure as a value next to the field: "" when the draft is valid.
  nameError: string = (valid && "") catch (e: NameRequired | NameTooLong) => e.message

  action pickTheme(t) { draftTheme := t }           // O-4: the form owns the draft; a picker beneath may only pick
  provide theme = { current: draftTheme, pick: pickTheme }
  provide density = draftDensity

  <div>
    <Panel title="Profile">
      <label>Display name{" "}<input data-testid="name" value={draftName} onInput={(ev) => { draftName := ev.target.value }} /></label>{" "}
      <small data-testid="name-count">{draftName.length}/20</small>{" "}
      {if nameError { <p data-testid="name-error" class="error">{nameError}</p> }}
    </Panel>{" "}
    <Panel title="Appearance">
      <Appearance>
        <button data-testid="density-toggle" onClick={() => { draftDensity := draftDensity == "compact" ? "comfortable" : "compact" }}>Toggle density</button>
      </Appearance>
    </Panel>{" "}
    <button data-testid="save" onClick={() => { if (nameError == "") { save(draft) } }}>Save</button>
  </div>
}
