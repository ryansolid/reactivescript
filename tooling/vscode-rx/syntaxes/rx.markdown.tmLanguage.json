{
  "comment": "```rx (or ```reactivescript) fences in Markdown, highlighted with the .rx grammar (source.rx). Injected into text.html.markdown, as VS Code's own Markdown grammar does for the languages it knows.",
  "scopeName": "markdown.rx.codeblock",
  "fileTypes": [],
  "injectionSelector": "L:text.html.markdown",
  "patterns": [{ "include": "#rx-code-block" }],
  "repository": {
    "rx-code-block": {
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(rx|reactivescript)((\\s+|:|,|\\{|\\?)[^`]*)?$)",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" },
        "4": { "name": "fenced_code.block.language.markdown" },
        "5": { "name": "fenced_code.block.language.attributes.markdown" }
      },
      "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
      "endCaptures": { "3": { "name": "punctuation.definition.markdown" } },
      "name": "markup.fenced_code.block.markdown",
      "patterns": [
        {
          "begin": "(^|\\G)(\\s*)(.*)",
          "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
          "contentName": "meta.embedded.block.rx",
          "patterns": [{ "include": "source.rx" }]
        }
      ]
    }
  }
}
