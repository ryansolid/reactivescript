{
  "name": "reactivescript",
  "displayName": "ReactiveScript",
  "description": "ReactiveScript (.rx, .d.rx): highlighting, and TypeScript's types, hover, go to definition, completion and errors through the .rx language server, with the compiler's own diagnostics; ```rx blocks highlighted in Markdown.",
  "version": "0.2.0",
  "publisher": "solidjs",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/client.js",
  "activationEvents": [
    "onLanguage:reactivescript"
  ],
  "contributes": {
    "languages": [
      {
        "id": "reactivescript",
        "aliases": [
          "ReactiveScript",
          "rx"
        ],
        "extensions": [
          ".rx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "reactivescript",
        "scopeName": "source.rx",
        "path": "./syntaxes/rx.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.css": "css"
        }
      },
      {
        "scopeName": "markdown.rx.codeblock",
        "path": "./syntaxes/rx.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.rx": "reactivescript"
        }
      }
    ],
    "configuration": {
      "title": "ReactiveScript",
      "properties": {
        "reactivescript.server.path": {
          "type": "string",
          "default": "",
          "description": "The language server's entry. Empty: the one bundled in this extension (dist/server.js)."
        },
        "reactivescript.rxc.path": {
          "type": "string",
          "default": "",
          "description": "An rxc binary for the server to run per request instead of the bundled WebAssembly build (dist/rxc.wasm). Empty: the bundled build."
        },
        "reactivescript.typescript.tsdk": {
          "type": "string",
          "default": "",
          "description": "TypeScript's lib folder. Empty: the workspace's node_modules/typescript, else the one VS Code ships."
        }
      }
    },
    "markdown.markdownItPlugins": true
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "vscode-languageclient": "^9.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/solidjs/reactivescript",
    "directory": "tooling/vscode-rx"
  },
  "scripts": {
    "build": "node build.js",
    "package": "node build.js && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.25.0"
  }
}
